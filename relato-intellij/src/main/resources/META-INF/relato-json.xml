<idea-plugin>
    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="relato.intellij.RelatoSchemaProviderFactory"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <externalAnnotator language="JSON" implementationClass="relato.intellij.json.FieldCheckAnnotator"/>
        <completion.contributor language="JSON" implementationClass="relato.intellij.json.FieldCompletionContributor" order="first"/>
        <intentionAction>
            <language>JSON</language>
            <className>relato.intellij.json.ImportFieldsIntention</className>
            <category>Relato</category>
        </intentionAction>
    </extensions>
</idea-plugin>
