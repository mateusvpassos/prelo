{
  "name": "prelo-desktop",
  "version": "0.1.0",
  "description": "Prelo — designer de relatórios desktop (Electron + motor Java)",
  "main": "main.js",
  "private": true,
  "author": "Mateus Vinicius dos Passos",
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "node scripts/prepare.js --quick && electron .",
    "icon": "electron scripts/make-icon.js",
    "shots": "electron scripts/screenshots.js",
    "dist": "node scripts/prepare.js --runtime && electron-builder --win nsis",
    "dist:dir": "node scripts/prepare.js --runtime && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.mateusvpassos.prelo",
    "productName": "Prelo",
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/engine",
        "to": "engine"
      },
      {
        "from": "build-resources/examples",
        "to": "examples"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prelo",
      "artifactName": "Prelo-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "license": "Apache-2.0"
}
